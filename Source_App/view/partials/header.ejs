    <style>
        .navbar-custom { background-color: #0d6efd; color: white; }
        .navbar-custom .nav-link { color: rgba(255,255,255,0.8); }
        .navbar-custom .nav-link:hover { color: white; }
        .table-header-custom { background-color: #dc3545; color: white; }
        .card { border-radius: 8px; border: 1px solid #dee2e6; }
        .form-label { font-weight: 500; color: #495057; }

        /* HIỆU ỨNG HOVER MỚI - TẤN CÔNG VÀO THẺ TD */
        .row-selectable {
            cursor: pointer;
            transition: all 0.15s ease;
        }
        /* Khi di chuột vào TR, ép tất cả các TD bên trong đổi màu */
        tbody tr.row-selectable:hover td {
            background-color: #f1f3f5 !important; 
            color: #000 !important;
        }

        /* Hiệu ứng khi nhấn giữ */
        tbody tr.row-selectable:active td {
            background-color: #e9ecef !important;
        }
        
    </style>
</head>
